# ==========================================================================
#  NURI · 누리 — configuración
#  Copia este archivo como .env (start.bat / start.sh lo hacen por ti).
#  Sin ODDS_API_KEY, NURI arranca en modo DEMO (simulador Zero-Config).
# ==========================================================================

# auto = datos reales de ESPN (sin llaves) · demo = simulador · oddsapi = The Odds API (requiere llave)
NURI_MODE=auto
NURI_APP_PORT=8765
NURI_TICK_SECONDS=5
# Minutos sin la ventana abierta antes de que NURI se apague solo
NURI_IDLE_MINUTES=20

# --------------------------------------------------------------------------
#  The Odds API  (https://the-odds-api.com · plan gratis 500 créditos/mes)
#  Cada consulta de cuotas cuesta (mercados × regiones) créditos. Con el plan
#  gratis NO pongas un polling bajo: 5 deportes cada 120 s se acaban la cuota
#  en horas. Para uso diario prueba 1–2 deportes y 600–900 s.
# --------------------------------------------------------------------------
ODDS_API_KEY=
ODDS_API_SPORTS=soccer_mexico_ligamx,soccer_epl,basketball_nba,americanfootball_nfl,icehockey_nhl
# pinnacle y betfair_ex_eu = líneas sharp de referencia · betway = casa con operación en México
ODDS_API_BOOKMAKERS=pinnacle,betfair_ex_eu,betway
# Llaves de The Odds API que se tratan como casas mexicanas (donde puedes apostar)
ODDS_API_MX_KEYS=betway
ODDS_API_POLL_SECONDS=120
# Player props (endpoint por evento, consume más créditos)
ODDS_API_PROPS=false
ODDS_API_PROPS_MAX_EVENTS=3

# --------------------------------------------------------------------------
#  API-Football / API-Sports  (https://api-sports.io · gratis 100 req/día)
#  Marcador, minuto, logos oficiales y estadísticas (xG, tiros, córners...)
# --------------------------------------------------------------------------
API_SPORTS_KEY=
API_SPORTS_POLL_SECONDS=900
API_SPORTS_STATS=false
API_SPORTS_STATS_MAX=2

# --------------------------------------------------------------------------
#  Logos oficiales vía TheSportsDB (llave pública "3", sin registro)
# --------------------------------------------------------------------------
LOGOS=on
THESPORTSDB_KEY=3

# --------------------------------------------------------------------------
#  Lectores de casas mexicanas (opcional, ver README → "Conectar Caliente,
#  Codere o Stake"). Pega la URL del JSON público de cuotas en vivo que ves
#  en DevTools → Red. MODE = http | playwright
# --------------------------------------------------------------------------
CALIENTE_FEED_URL=
CALIENTE_MODE=http
CODERE_FEED_URL=
CODERE_MODE=http
STAKE_FEED_URL=
STAKE_MODE=http
# Para feeds GraphQL (POST) pega aquí el cuerpo JSON de la petición
STAKE_FEED_BODY=
SCRAPER_POLL_SECONDS=20

# --------------------------------------------------------------------------
#  Motor cuantitativo
# --------------------------------------------------------------------------
MC_ITERATIONS=25000
EV_THRESHOLD=0.045
KELLY_FRACTION=0.25
KELLY_CAP=0.06
MIN_STAKE_MXN=10
MAX_CREDIBLE_EV=0.25

# Demo: segundos de juego por segundo real (fútbol). 4 = un partido dura ~25 min.
DEMO_SPEED=4

# ----------------------------------------------------------------------------
#  Caliente / Codere MX en tiempo real · odds-api.io  (https://odds-api.io/pricing · plan Solo)
#  Mejor pégala desde NURI (Radar → Conectar Caliente y Codere). Si la pones aquí, gana esta.
# ----------------------------------------------------------------------------
ODDSIO_KEY=
